    {
      "parameters": {
        "jsCode": "const PATTERNS = [\n  /Bearer\\s+[A-Za-z0-9._~+\\/=-]+/gi,\n  /\\bxox[abprs]-[A-Za-z0-9-]+/g,\n  /\\bsk-[A-Za-z0-9_-]{16,}/g,\n  /\\bgh[pousr]_[A-Za-z0-9]{20,}/g,\n  /\\bAKIA[0-9A-Z]{16}\\b/g,\n  /\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]*/g,\n  /\\b\\d{8,10}:[A-Za-z0-9_-]{30,}\\b/g,\n  /(api[_-]?key|token|secret|passwd|password)\\s*[=:]\\s*\\S+/gi,\n  /\\b[A-Za-z0-9_-]{32,}\\b/g,\n];\nconst mask = (s) => PATTERNS.reduce((acc, re) => acc.replace(re, \"[REDACTED]\"), String(s == null ? \"\" : s));\nreturn $input.all().map((item, i) => {\n  const a = $(\"Remove Duplicate Alerts\").all()[i].json;\n  const intel = $(\"IP Intelligence Lookup\").all()[i].json;\n  const v = item.json.output || {};\n  const text = (a.rule_name + \" \" + a.user).toLowerCase();\n  const risky = !!intel.proxy || !!intel.hosting;\n  const priv = /admin|root|svc-|service/.test(text);\n  let rb = \"low\";\n  if (/ransom|malware|beacon|exfil|c2|command and control|data leak/.test(text) || (priv && !!intel.proxy && /spray|brute|travel|failed/.test(text))) rb = \"critical\";\n  else if (/spray|brute|impossible travel|tor |privilege|lateral|disabled antivirus/.test(text) || (risky && /failed|login/.test(text) && priv)) rb = \"high\";\n  else if (/successful|logout|routine|scheduled|completed|password changed/.test(text) && !/failed|denied|suspicious|unusual/.test(text)) rb = \"low\";\n  else if (/failed|denied|suspicious|unusual|scan/.test(text) || risky) rb = \"medium\";\n  const recs = { low: \"Log only; no action required.\", medium: \"Monitor the user and IP for 24h; verify with the user if activity repeats.\", high: \"Reset the user credentials, review recent sessions and consider rate-limiting the IP.\", critical: \"Isolate the affected account/host and block the source IP after analyst approval.\" };\n  let severity = String(v.severity || \"\").toLowerCase().trim();\n  let classified_by = \"ai\";\n  if (![\"low\", \"medium\", \"high\", \"critical\"].includes(severity)) { severity = rb; classified_by = \"rule-based\"; }\n  return { json: {\n    alert_key: a.alert_key,\n    rule_name: mask(a.rule_name),\n    source_ip: mask(a.source_ip),\n    user: mask(a.user),\n    timestamp: mask(a.timestamp),\n    severity,\n    classified_by,\n    recommendation: mask(v.recommendation || recs[severity]).slice(0, 500),\n    reasoning: mask(v.reasoning || (\"Rule-based score from rule name, user and IP reputation (proxy=\" + !!intel.proxy + \", hosting=\" + !!intel.hosting + \")\")).slice(0, 500),\n    ip_country: mask(intel.country),\n    ip_isp: mask(intel.isp),\n    ip_proxy: !!intel.proxy,\n    ip_hosting: !!intel.hosting,\n    summary: mask(a.rule_name) + \" from \" + mask(a.source_ip) + \" (\" + mask(intel.country) + \") by \" + mask(a.user),\n  } };\n});"
      },
