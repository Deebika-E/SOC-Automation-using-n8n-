    {
      "parameters": {
        "jsCode": "const PATTERNS = [\n  /Bearer\\s+[A-Za-z0-9._~+\\/=-]+/gi,\n  /\\bxox[abprs]-[A-Za-z0-9-]+/g,\n  /\\bsk-[A-Za-z0-9_-]{16,}/g,\n  /\\bgh[pousr]_[A-Za-z0-9]{20,}/g,\n  /\\bAKIA[0-9A-Z]{16}\\b/g,\n  /\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]*/g,\n  /\\b\\d{8,10}:[A-Za-z0-9_-]{30,}\\b/g,\n  /(api[_-]?key|token|secret|passwd|password)\\s*[=:]\\s*\\S+/gi,\n  /\\b[A-Za-z0-9_-]{32,}\\b/g,\n];\nconst mask = (s) => PATTERNS.reduce((acc, re) => acc.replace(re, \"[REDACTED]\"), String(s == null ? \"\" : s));\nreturn $input.all().map((item) => {\n  const b = item.json.body || item.json;\n  const rule_name = mask(b.rule_name).slice(0, 200);\n  const source_ip = mask(b.source_ip).trim();\n  const user = mask(b.user).slice(0, 100);\n  const timestamp = mask(b.timestamp);\n  const alert_key = [rule_name, source_ip, user, timestamp].join(\"|\").toLowerCase();\n  return { json: { rule_name, source_ip, user, timestamp, alert_key } };\n});"
      },
